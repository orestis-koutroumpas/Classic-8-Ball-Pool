#version 330 core

//Inputs
in vec4 vertex_position_cameraspace;
in vec4 vertex_normal_cameraspace;
in vec4 light_position_cameraspace[10];
in vec2 vertex_UV;
in vec4 vertex_position_lightspace[10];

//Light properties
struct Light {
    vec4 La;   //Ambient light color
    vec4 Ld;   //Diffuse light color
    vec4 Ls;   //Specular light color
    vec3 lightPosition_worldspace;
    float power;  //Light power/intensity
};

//Material properties
struct Material {
    vec4 Ka;   //Ambient reflectivity
    vec4 Kd;   //Diffuse reflectivity
    vec4 Ks;   //Specular reflectivity
    float Ns;  //Shininess factor
};

uniform sampler2D textureSampler;
uniform sampler2D shadowMapSampler[10];
uniform int useTexture = 0;
uniform Light light[10];
uniform Material mtl;
uniform int calculateShadow;

//Output color
out vec4 fragmentColor;

// Function declarations
vec4 phong(Light light, vec4 light_position_cameraspace, float visibility);
float ShadowCalculation(vec4 fragPositionLightspace, sampler2D shadowMapSampler);

void main() {
    vec4 color = vec4(0, 0, 0, 1);
    float shadow = 0.0f;

    for (int i=0; i<10; ++i){
    if (calculateShadow == 1){
        shadow = ShadowCalculation(vertex_position_lightspace[i], shadowMapSampler[i]);
        }
        color += phong(light[i], light_position_cameraspace[i], 1.0 - shadow);
    }
    fragmentColor = color;
}

float ShadowCalculation(vec4 fragPositionLightspace, sampler2D shadowMapSampler) {
    // Given the position of a fragment in lightspace coordinates
    // We sample the depth buffer to see whether or not the fragment is shadowed
    
    float shadow;

    // Task 4.3
    // Perspective devide to bring coordinates in range[-1, 1]
    vec3 projCoords = fragPositionLightspace.xyz / fragPositionLightspace.w;

    // Since the depth map values are in range[0, 1]
    projCoords = 0.5 * projCoords + 0.5;

    // Sampling the closest point in this position from the depth map
    // REMINDER: Since we are in lightspace coordinates,
    //           the z parameter is the depth from the camera
    float closestDepth = texture(shadowMapSampler, projCoords.xy).r;

    // Then we get the depth of the current vertex
    float currentDepth = projCoords.z;

    // If the currentDepth is larger than the closestDepth, the fragment is shadowed
    shadow = currentDepth > closestDepth ? 1.0 : 0.0 ;

    // Task 4.4
    // Correcting the quantization problem
    float bias = 0.01;
    shadow = currentDepth > closestDepth + bias ? 1.0 : 0.0 ;;

    // Task 4.6 Make the shadow edges more realistic
    shadow = 0.0;
    vec2 depthMap_dimensions = textureSize(shadowMapSampler, 0);
    vec2 texelSize = 1.0 / depthMap_dimensions;
    for(int x = -1; x <= 1; x++ ){
        for(int y = -1; y <= 1; y++ ){
            float pcfDepth = texture(shadowMapSampler, projCoords.xy + vec2(x, y) * texelSize).r;
            shadow += currentDepth - bias > pcfDepth ? 1.0 : 0.0;
        }
    }
    shadow /= 9.0;

    // Task 4.5
    if(projCoords.z > 1)
        shadow = 0.0;

    return shadow;
}

vec4 phong(Light light, vec4 light_position_cameraspace, float visibility) {

    vec4 _Ks = mtl.Ks;
    vec4 _Kd = mtl.Kd;
    vec4 _Ka = mtl.Ka;
    float _Ns = mtl.Ns;

    if (useTexture == 1) {
        _Ks = vec4(1.0, 1.0, 1.0, 1.0);
        _Kd = texture(textureSampler, vertex_UV);
        _Ka = vec4(0.05 * _Kd.rgb, _Kd.a);
        _Ns = 10;
     }

    // Ambient lighting
    vec4 Ia = light.La * _Ka;

    // Diffuse lighting
    vec4 N = normalize(vertex_normal_cameraspace); 
    vec4 L = normalize(light_position_cameraspace - vertex_position_cameraspace);
    float cosTheta = clamp(dot(N, L), 0.0, 1.0);
    vec4 Id = light.Ld * _Kd * cosTheta;

    // Specular lighting
    vec4 R = reflect(-L, N);
    vec4 E = normalize(vec4(0.0, 0.0, 0.0, 1.0) - vertex_position_cameraspace);
    float cosAlpha = clamp(dot(E, R), 0.0, 1.0);
    float specular_factor = pow(cosAlpha, _Ns);
    vec4 Is = light.Ls * _Ks * specular_factor;

    float d = length(vertex_position_cameraspace - light_position_cameraspace);
    float k = 1 / light.power;
    float attenuation = 1 / (1 + k * (d*d));

    // Combine lighting components, taking visibility into account
    return attenuation * (Ia + Id * visibility + Is * visibility);
}